{
  "project": "project-symfony",
  "gate": [
    "./bin/.build-full"
  ],
  "outputs": [
    "var/reports/coverage/unit",
    "config/reference.php"
  ],
  "directories": [
    "var/cache"
  ],
  "environment": {
    "PROJECT_SYMFONY_CHECKOUT": "{checkout}"
  },
  "images": [
    "api",
    "server"
  ],
  "mount_git": false,
  "https_preview": {"service": "server", "network": "app-network", "port": 80}
}
