#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR/.."

if [[ $# -ne 0 ]]; then
    echo 'Usage: ./bin/prepare (prepares this registered checkout; no arguments)' >&2
    exit 1
fi

./bin/up --worktree "$PWD"
./bin/composer install --no-interaction --prefer-dist --no-progress
./bin/doctor
