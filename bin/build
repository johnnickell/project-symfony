#!/usr/bin/env sh
set -eu

image=project-symfony-build
docker build --tag "$image" .
docker run --rm --env APP_SECRET=build-only-secret --volume "$(pwd):/app" --workdir /app "$image" sh -ec '
    php scripts/validate-composer-candidate.php
    composer install --no-interaction --prefer-dist --no-progress
    python3 scripts/planning_portfolio.py
    vendor/bin/phpunit

    production_root=$(mktemp -d)
    trap "rm -rf \"$production_root\"" EXIT
    cp -a . "$production_root"
    cd "$production_root"
    composer install --no-dev --no-interaction --prefer-dist --no-progress
    php scripts/production-autoload-check.php
'
