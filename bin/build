#!/usr/bin/env sh
set -eu

./bin/planning-check

image=project-symfony-build
git_common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
docker build --file etc/docker/build/Dockerfile --tag "$image" .
docker run --rm --env APP_SECRET=build-only-secret --volume "$(pwd):/app" \
    --volume "$git_common_dir:$git_common_dir:ro" --workdir /app "$image" sh -ec '
    php scripts/validate-composer-candidate.php
    composer install --no-interaction --prefer-dist --no-progress
    php scripts/generate-framework-support-receipt.php
    scripts/verify-dependency-lanes.sh

    work_root=$(mktemp -d)
    trap "rm -rf \"$work_root\"" EXIT
    git clone --quiet --no-checkout https://github.com/johnnickell/fight-common "$work_root/fight-common"
    git -C "$work_root/fight-common" checkout --quiet --detach fad24ae9fdcf4ac00fa55c59ef7d35f7c7531911
    php scripts/verify-framework-support-receipt.php "$work_root/fight-common"

    php vendor/bin/phpcs
    php vendor/bin/phpstan analyse --no-progress
    php vendor/bin/deptrac --fail-on-uncovered --report-uncovered --report-skipped
    php vendor/bin/deptrac debug:unassigned --no-cache
    php vendor/bin/rector process src tests --dry-run --no-progress-bar

    rm -f var/reports/coverage/clover.xml
    php vendor/bin/phpunit --fail-on-skipped --fail-on-notice --fail-on-warning
    php scripts/check-coverage.php

    production_root="$work_root/production"
    mkdir "$production_root"
    cp -a . "$production_root"
    cd "$production_root"
    composer install --no-dev --no-interaction --prefer-dist --no-progress
    php scripts/production-autoload-check.php
'
