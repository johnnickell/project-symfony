#!/usr/bin/env sh
set -eu

./bin/planning-check

image=project-symfony-build
docker build --file etc/docker/build/Dockerfile --tag "$image" .
docker run --rm --env APP_SECRET=build-only-secret --volume "$(pwd):/app" \
    --workdir /app "$image" sh -ec '
    composer validate --strict
    composer install --no-interaction --prefer-dist --no-progress
    find config public scripts src -type f -name "*.php" -print0 | xargs -0 -n1 php -l

    php vendor/bin/phpcs
    php vendor/bin/phpstan analyse --no-progress
    php vendor/bin/deptrac --fail-on-uncovered --report-uncovered --report-skipped
    php vendor/bin/deptrac debug:unassigned --no-cache
    php vendor/bin/rector process src tests --dry-run --no-progress-bar

    rm -f var/reports/coverage/clover.xml
    php vendor/bin/phpunit --testsuite Unit --fail-on-skipped --fail-on-notice --fail-on-warning
    php scripts/check-coverage.php
    php vendor/bin/phpunit --testsuite Integration --fail-on-skipped --fail-on-notice --fail-on-warning
    php vendor/bin/phpunit --testsuite Functional --fail-on-skipped --fail-on-notice --fail-on-warning
'
