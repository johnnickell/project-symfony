{
    "name": "johnnickell/project-symfony",
    "description": "Public Symfony application composition for Fight libraries.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.6",
        "johnnickell/fight-access-control": "dev-develop",
        "johnnickell/fight-common": "^1.1",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/string": "^8.1",
        "symfony/twig-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "johnnickell/fight-common",
                "version": "1.2.0-dev",
                "source": {
                    "type": "git",
                    "url": "https://github.com/johnnickell/fight-common.git",
                    "reference": "4a798b1db8fdb5e4af7d0ba8c98a88ac53c50c16"
                },
                "require": {
                    "php": ">=8.5",
                    "psr/cache": "^3.0",
                    "psr/container": "^2.0",
                    "psr/http-client": "^1.0",
                    "psr/http-factory": "^1.1",
                    "psr/http-message": "^2.0",
                    "psr/http-server-handler": "^1.0",
                    "psr/http-server-middleware": "^1.0",
                    "psr/log": "^3.0"
                },
                "autoload": {
                    "psr-4": {
                        "Fight\\Common\\": "src/"
                    },
                    "files": [
                        "src/Domain/functions.php"
                    ]
                }
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-access-control"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Fight\\Common\\": "vendor/johnnickell/fight-common/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "github-protocols": [
            "https"
        ],
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
