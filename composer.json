{
    "name": "johnnickell/project-symfony",
    "description": "Public Symfony application composition for Fight libraries.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.6",
        "dragonmantank/cron-expression": "^3.0",
        "guzzlehttp/guzzle": "^7.10",
        "guzzlehttp/psr7": "^2.9",
        "johnnickell/fight-access-control": "dev-develop",
        "johnnickell/fight-common": "dev-develop as 1.1.9999999-dev",
        "lcobucci/jwt": "^5.6",
        "league/flysystem": "^3.0",
        "symfony/console": "^8.1",
        "symfony/doctrine-bridge": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/mercure": "^0.7",
        "symfony/messenger": "^8.1",
        "symfony/process": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/string": "^8.1",
        "symfony/twig-bridge": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/validator": "^8.1",
        "twilio/sdk": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-common"
        },
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-access-control"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "github-protocols": [
            "https"
        ],
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
