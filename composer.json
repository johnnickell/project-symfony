{
    "name": "johnnickell/project-symfony",
    "description": "Public Symfony application composition for Fight libraries.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "johnnickell/fight-access-control": "dev-develop",
        "johnnickell/fight-common": "^1.1",
        "symfony/console": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/string": "^8.1",
        "symfony/twig-bundle": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/johnnickell/fight-access-control"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
